# Model gateway - which vendor to use: "anthropic" (default) or "openai"
GCIA_MODEL_PROVIDER=anthropic

ANTHROPIC_API_KEY=
GCIA_MODEL_SMALL=claude-haiku-4-5-20251001
GCIA_MODEL_LARGE=claude-sonnet-5

# Only used if GCIA_MODEL_PROVIDER=openai
OPENAI_API_KEY=
GCIA_OPENAI_MODEL_SMALL=gpt-4o-mini
GCIA_OPENAI_MODEL_LARGE=gpt-4o

# Per-run budget enforcement (Orchestrator; see docs/PRODUCT_REQUIREMENTS.md DoD "cost controls")
GCIA_MAX_TOKENS_PER_RUN=200000
GCIA_MAX_COST_USD_PER_RUN=5.00

# Local dev infra. SQLite needs nothing running; uncomment the Postgres line
# (and `docker-compose up -d postgres`) once you outgrow a single laptop.
DATABASE_URL=sqlite:///./gcia.db
# DATABASE_URL=postgresql://gcia:gcia@localhost:5432/gcia
REDIS_URL=redis://localhost:6379/0

# API
GCIA_API_HOST=0.0.0.0
GCIA_API_PORT=8000

# RBAC (NFR-011): "key:role,key:role,..." - empty means no access control,
# fine for a single-laptop demo. Example:
# GCIA_API_KEYS=dev-viewer-key:viewer,dev-analyst-key:analyst,dev-admin-key:admin
GCIA_API_KEYS=
